@model RestaurantManagement.Models.Floor

@{
    ViewData["Title"] = "Xóa tầng";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <h5 class="alert alert-warning">Bạn có chắc chắn muốn xóa tầng này?</h5>
                
                <dl class="row">
                    <dt class="col-sm-3">Tên tầng:</dt>
                    <dd class="col-sm-9">@Model.Name</dd>
                    
                    <dt class="col-sm-3">Mô tả:</dt>
                    <dd class="col-sm-9">@Model.Description</dd>
                    
                    <dt class="col-sm-3">Số bàn:</dt>
                    <dd class="col-sm-9">@Model.Tables.Count</dd>
                </dl>
                
                @if (Model.Tables.Any())
                {
                    <div class="alert alert-danger">
                        <strong>Cảnh báo!</strong> Không thể xóa tầng này vì có @Model.Tables.Count bàn đang được sử dụng. 
                        Vui lòng xóa hoặc chuyển các bàn sang tầng khác trước khi xóa tầng này.
                    </div>
                }
                
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Trở lại
                        </a>
                        @if (!Model.Tables.Any())
                        {
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Xác nhận xóa
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div> 