@model RestaurantManagement.Models.MenuCategory

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Trở lại
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Chỉnh sửa
                        </a>
                    }
                </div>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Tên danh mục:</dt>
                    <dd class="col-sm-9">@Model.Name</dd>
                    
                    <dt class="col-sm-3">Mô tả:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "Không có" : Model.Description)</dd>
                    
                    <dt class="col-sm-3">Thứ tự hiển thị:</dt>
                    <dd class="col-sm-9">@Model.DisplayOrder</dd>
                    
                    <dt class="col-sm-3">Trạng thái:</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsAvailable)
                        {
                            <span class="badge bg-success">Đang phục vụ</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Ngừng phục vụ</span>
                        }
                    </dd>
                </dl>
                
                @if (User.IsInRole("Admin"))
                {
                    <div class="mt-3">
                        <a asp-action="ToggleStatus" asp-route-id="@Model.Id" class="btn @(Model.IsAvailable ? "btn-danger" : "btn-success")">
                            <i class="bi bi-toggle-on"></i> @(Model.IsAvailable ? "Ngừng phục vụ" : "Bắt đầu phục vụ")
                        </a>
                    </div>
                }
            </div>
        </div>
        
        <div class="card shadow mt-4">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Danh sách món ăn trong danh mục</h4>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="MenuItem" asp-action="Create" asp-route-categoryId="@Model.Id" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Thêm món mới
                    </a>
                }
            </div>
            <div class="card-body">
                @if (Model.MenuItems != null && Model.MenuItems.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên món</th>
                                    <th>Giá</th>
                                    <th>Giá KM</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.MenuItems)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.Price.ToString("N0") đ</td>
                                        <td>
                                            @if (item.DiscountedPrice.HasValue)
                                            {
                                                @item.DiscountedPrice.Value.ToString("N0") <span>đ</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsAvailable)
                                            {
                                                <span class="badge bg-success">Đang phục vụ</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Ngừng phục vụ</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-controller="MenuItem" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <a asp-controller="MenuItem" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <a asp-controller="MenuItem" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        Chưa có món ăn nào trong danh mục này.
                    </div>
                }
            </div>
        </div>
    </div>
</div> 