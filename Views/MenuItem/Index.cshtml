@model IEnumerable<RestaurantManagement.Models.MenuItem>

@{
    ViewData["Title"] = "Quản lý thực đơn";
}

<div class="card shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h3 class="mb-0">@ViewData["Title"]</h3>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Thêm món mới
            </a>
        }
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover" id="menuItemList">
                <thead class="table-light">
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên món</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>Giá KM</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="width: 80px;">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)" 
                                     alt="@item.Name" class="img-thumbnail" style="max-width: 80px;" />
                            </td>
                            <td>
                                @item.Name
                                @if (item.IsFeatured)
                                {
                                    <span class="badge bg-warning ms-2">
                                        <i class="bi bi-star-fill"></i>
                                    </span>
                                }
                            </td>
                            <td>@item.MenuCategory?.Name</td>
                            <td>@item.Price.ToString("N0") đ</td>
                            <td>
                                @if (item.DiscountedPrice.HasValue)
                                {
                                    <span class="text-danger">@item.DiscountedPrice.Value.ToString("N0") đ</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">Đang phục vụ</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Ngừng phục vụ</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" data-bs-toggle="tooltip" title="Chi tiết">
                                        <i class="fas fa-eye"></i> <span class="d-none d-md-inline">Chi tiết</span>
                                    </a>
                                    
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary" data-bs-toggle="tooltip" title="Sửa">
                                            <i class="fas fa-edit"></i> <span class="d-none d-md-inline">Sửa</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" data-bs-toggle="tooltip" title="Xóa">
                                            <i class="fas fa-trash"></i> <span class="d-none d-md-inline">Xóa</span>
                                        </a>
                                        <a asp-action="ToggleFeatured" asp-route-id="@item.Id" class="btn btn-warning" data-bs-toggle="tooltip" title="@(item.IsFeatured ? "Bỏ nổi bật" : "Đặt nổi bật")">
                                            <i class="fas fa-star@(item.IsFeatured ? "" : "-half")"></i> <span class="d-none d-md-inline">@(item.IsFeatured ? "Bỏ sao" : "Đặt sao")</span>
                                        </a>
                                        <a asp-action="ToggleStatus" asp-route-id="@item.Id" class="btn @(item.IsAvailable ? "btn-secondary" : "btn-success")" data-bs-toggle="tooltip" title="@(item.IsAvailable ? "Ngừng bán" : "Bán lại")">
                                            <i class="fas @(item.IsAvailable ? "fa-toggle-on" : "fa-toggle-off")"></i> <span class="d-none d-md-inline">@(item.IsAvailable ? "Ngừng" : "Kích hoạt")</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Kích hoạt tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
            
            // Tự động đóng alert sau 5 giây
            setTimeout(function () {
                $(".alert").alert('close');
            }, 5000);
            
            // Thêm DataTable cho bảng
            $('#menuItemList').DataTable({
                "language": {
                    "search": "Tìm kiếm:",
                    "lengthMenu": "Hiển thị _MENU_ dòng mỗi trang",
                    "zeroRecords": "Không tìm thấy dữ liệu",
                    "info": "Hiển thị trang _PAGE_ / _PAGES_",
                    "infoEmpty": "Không có dữ liệu",
                    "infoFiltered": "(lọc từ _MAX_ dòng)",
                    "paginate": {
                        "first": "Đầu",
                        "last": "Cuối",
                        "next": "Sau",
                        "previous": "Trước"
                    }
                },
                "columnDefs": [
                    { "orderable": false, "targets": [0, 6] }
                ]
            });
        });
    </script>
} 