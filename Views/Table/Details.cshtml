@model RestaurantManagement.Models.Table

@{
    ViewData["Title"] = "Chi tiết bàn";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Trở lại
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Chỉnh sửa
                        </a>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Tên bàn:</dt>
                            <dd class="col-sm-8">@Model.Name</dd>
                            
                            <dt class="col-sm-4">Tầng:</dt>
                            <dd class="col-sm-8">@Model.Floor.Name</dd>
                            
                            <dt class="col-sm-4">Sức chứa:</dt>
                            <dd class="col-sm-8">@Model.Capacity người</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Trạng thái:</dt>
                            <dd class="col-sm-8">
                                @if (Model.IsOccupied)
                                {
                                    <span class="badge bg-danger">Đang sử dụng</span>
                                }
                                else if (Model.Status == "Reserved")
                                {
                                    <span class="badge bg-warning">Đã đặt trước</span>
                                }
                                else if (Model.Status == "Cleaning")
                                {
                                    <span class="badge bg-info">Đang dọn dẹp</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Trống</span>
                                }
                            </dd>
                            
                            <dt class="col-sm-4">Ghi chú:</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Status) ? "Không có" : Model.Status)</dd>
                        </dl>
                    </div>
                </div>
                
                <div class="mt-3">
                    @if (Model.IsOccupied)
                    {
                        <a asp-action="MoveTable" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-arrow-left-right"></i> Chuyển bàn
                        </a>
                    }
                </div>
            </div>
        </div>
        
        <div class="card shadow mt-4">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Lịch sử đơn hàng gần đây</h4>
            </div>
            <div class="card-body">
                @if (Model.Orders != null && Model.Orders.Any())
                {
                    <div class="accordion" id="orderAccordion">
                        @foreach (var order in Model.Orders)
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading@(order.Id)">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@(order.Id)" aria-expanded="false" aria-controls="collapse@(order.Id)">
                                        <span class="me-2">Đơn #@order.Id</span>
                                        <span class="me-2">@order.OrderTime.ToString("dd/MM/yyyy HH:mm")</span>
                                        <span class="badge bg-@(order.Status == "Completed" ? "success" : 
                                                            order.Status == "Pending" ? "warning" : 
                                                            order.Status == "Processing" ? "primary" : 
                                                            order.Status == "Cancelled" ? "danger" : "secondary")">
                                            @order.Status
                                        </span>
                                    </button>
                                </h2>
                                <div id="collapse@(order.Id)" class="accordion-collapse collapse" aria-labelledby="heading@(order.Id)" data-bs-parent="#orderAccordion">
                                    <div class="accordion-body">
                                        <table class="table table-sm table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Món</th>
                                                    <th>Số lượng</th>
                                                    <th>Đơn giá</th>
                                                    <th>Thành tiền</th>
                                                    <th>Trạng thái</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <tr>
                                                        <td>@item.MenuItem.Name</td>
                                                        <td>@item.Quantity</td>
                                                        <td>@item.Price.ToString("N0") đ</td>
                                                        <td>@((item.Price * item.Quantity).ToString("N0")) đ</td>
                                                        <td>
                                                            <span class="badge bg-@(item.Status == "Served" ? "success" : 
                                                                                item.Status == "Pending" ? "warning" : 
                                                                                item.Status == "Preparing" ? "primary" : 
                                                                                item.Status == "Ready" ? "info" : 
                                                                                item.Status == "Cancelled" ? "danger" : "secondary")">
                                                                @item.Status
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th colspan="3" class="text-end">Tổng:</th>
                                                    <th>@order.OrderItems.Sum(i => i.Price * i.Quantity).ToString("N0") đ</th>
                                                    <th></th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                        
                                        @if (!string.IsNullOrEmpty(order.Notes))
                                        {
                                            <div class="alert alert-info mt-2">
                                                <strong>Ghi chú:</strong> @order.Notes
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        Không có đơn hàng gần đây cho bàn này.
                    </div>
                }
            </div>
        </div>
    </div>
</div> 