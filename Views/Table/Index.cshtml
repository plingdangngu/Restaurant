@model IEnumerable<RestaurantManagement.Models.Table>

@{
    ViewData["Title"] = "Quản lý bàn ăn";
}

<div class="card shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h3 class="mb-0">@ViewData["Title"]</h3>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Thêm bàn mới
            </a>
        }
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover" id="tableList">
                <thead class="table-light">
                    <tr>
                        <th>Tên bàn</th>
                        <th>Tầng</th>
                        <th>Sức chứa</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Floor.Name</td>
                            <td>@item.Capacity người</td>
                            <td>
                                @if (item.IsOccupied)
                                {
                                    <span class="badge bg-danger">Đang sử dụng</span>
                                }
                                else if (item.Status == "Reserved")
                                {
                                    <span class="badge bg-warning">Đã đặt trước</span>
                                }
                                else if (item.Status == "Cleaning")
                                {
                                    <span class="badge bg-info">Đang dọn dẹp</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Trống</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" data-bs-toggle="tooltip" title="Chi tiết">
                                        <i class="fas fa-eye"></i> <span class="d-none d-md-inline">Chi tiết</span>
                                    </a>
                                    
                                    @if (item.IsOccupied)
                                    {
                                        <a asp-action="MoveTable" asp-route-id="@item.Id" class="btn btn-warning" data-bs-toggle="tooltip" title="Chuyển bàn">
                                            <i class="fas fa-exchange-alt"></i> <span class="d-none d-md-inline">Chuyển</span>
                                        </a>
                                    }
                                    
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary" data-bs-toggle="tooltip" title="Sửa">
                                            <i class="fas fa-edit"></i> <span class="d-none d-md-inline">Sửa</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" data-bs-toggle="tooltip" title="Xóa">
                                            <i class="fas fa-trash"></i> <span class="d-none d-md-inline">Xóa</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Kích hoạt tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
            
            // Tự động đóng alert sau 5 giây
            setTimeout(function () {
                $(".alert").alert('close');
            }, 5000);
            
            // Thêm DataTable cho bảng
            $('#tableList').DataTable({
                "language": {
                    "search": "Tìm kiếm:",
                    "lengthMenu": "Hiển thị _MENU_ dòng mỗi trang",
                    "zeroRecords": "Không tìm thấy dữ liệu",
                    "info": "Hiển thị trang _PAGE_ / _PAGES_",
                    "infoEmpty": "Không có dữ liệu",
                    "infoFiltered": "(lọc từ _MAX_ dòng)",
                    "paginate": {
                        "first": "Đầu",
                        "last": "Cuối",
                        "next": "Sau",
                        "previous": "Trước"
                    }
                }
            });
        });
    </script>
} 