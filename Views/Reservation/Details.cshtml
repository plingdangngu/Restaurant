@model RestaurantManagement.Models.Order

@{
    ViewData["Title"] = "Chi tiết đặt bàn";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">@ViewData["Title"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Reservation" asp-action="MyReservations">Đơn đặt của tôi</a></li>
        <li class="breadcrumb-item active">Chi tiết đơn #@Model.Id</li>
    </ol>

    <div class="row">
        <div class="col-xl-8 col-lg-10 mx-auto">
            <div class="card mb-4 shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Thông tin đặt bàn #@Model.Id</h5>
                    <div>
                        @if (Model.Status == "Reserved" || Model.Status == "Pending")
                        {
                            <a asp-controller="Order" asp-action="AddItem" asp-route-id="@Model.Id" class="btn btn-sm btn-light">
                                <i class="fas fa-utensils me-1"></i>Thêm món
                            </a>
                            <a asp-controller="Reservation" asp-action="Cancel" asp-route-id="@Model.Id" 
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Bạn có chắc chắn muốn hủy đặt bàn này?')">
                                <i class="fas fa-times me-1"></i>Hủy đặt
                            </a>
                        }
                        <a asp-controller="Reservation" asp-action="MyReservations" class="btn btn-sm btn-light">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5 class="border-bottom pb-2 text-primary">Thông tin chung</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Mã đơn</dt>
                                <dd class="col-sm-8">#@Model.Id</dd>
                                
                                <dt class="col-sm-4">Thời gian</dt>
                                <dd class="col-sm-8">@Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</dd>
                                
                                <dt class="col-sm-4">Trạng thái</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Status == "Reserved")
                                    {
                                        <span class="badge bg-info">Đã đặt</span>
                                    }
                                    else if (Model.Status == "Pending" || Model.Status == "Processing")
                                    {
                                        <span class="badge bg-primary">Đang phục vụ</span>
                                    }
                                    else if (Model.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Hoàn thành</span>
                                    }
                                    else if (Model.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Model.Status</span>
                                    }
                                </dd>
                                
                                <dt class="col-sm-4">Số người</dt>
                                <dd class="col-sm-8">@Model.PeopleCount người</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5 class="border-bottom pb-2 text-primary">Thông tin bàn</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Bàn</dt>
                                <dd class="col-sm-8">Bàn @Model.Table?.Name</dd>
                                
                                <dt class="col-sm-4">Vị trí</dt>
                                <dd class="col-sm-8">Tầng @Model.Table?.Floor?.Name</dd>
                                
                                <dt class="col-sm-4">Sức chứa</dt>
                                <dd class="col-sm-8">@Model.Table?.Capacity người</dd>
                                
                                <dt class="col-sm-4">Ghi chú</dt>
                                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Notes) ? "Không có" : Model.Notes)</dd>
                            </dl>
                        </div>
                    </div>

                    @if (Model.OrderItems != null && Model.OrderItems.Any())
                    {
                        <h5 class="border-bottom pb-2 text-primary">Các món đã đặt</h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên món</th>
                                        <th class="text-end">Số lượng</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int stt = 0;
                                        decimal total = 0;
                                    }
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        stt++;
                                        decimal itemTotal = item.Quantity * item.Price;
                                        total += itemTotal;
                                        
                                        <tr>
                                            <td>@stt</td>
                                            <td>@item.MenuItem?.Name</td>
                                            <td class="text-end">@item.Quantity</td>
                                            <td class="text-end">@item.Price.ToString("N0") ₫</td>
                                            <td class="text-end">@itemTotal.ToString("N0") ₫</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td colspan="4" class="text-end">Tổng cộng</td>
                                        <td class="text-end">@total.ToString("N0") ₫</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>Chưa có món ăn nào được đặt.
                            @if (Model.Status == "Reserved" || Model.Status == "Pending")
                            {
                                <a asp-controller="Order" asp-action="AddItem" asp-route-id="@Model.Id" class="alert-link ms-2">
                                    Đặt món ngay!
                                </a>
                            }
                        </div>
                    }
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>
                            <i class="fas fa-clock me-1"></i>Đặt lúc: @Model.OrderTime.ToString("dd/MM/yyyy HH:mm")
                        </span>
                        <a asp-controller="Reservation" asp-action="MyReservations" class="btn btn-sm btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 