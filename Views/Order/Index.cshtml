@model List<RestaurantManagement.Models.Order>
@{
    var currentPage = (int)ViewData["CurrentPage"];
    var totalPages = (int)ViewData["TotalPages"];
    var status = (string)ViewData["Status"];
    var searchString = (string)ViewData["SearchString"];
    var statusList = (List<string>)ViewData["StatusList"];
    var totalValue = (decimal)ViewData["TotalValue"];
    var isAdminView = ViewData["IsAdminView"] != null && (bool)ViewData["IsAdminView"];
    
    ViewData["Title"] = isAdminView ? "Quản lý đơn hàng" : "Đơn hàng của tôi";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">@ViewData["Title"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item active">@ViewData["Title"]</li>
    </ol>

    <!-- Toast Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorMessage">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="row mb-3">
        <!-- Order Stats Cards -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="m-0">Tổng đơn hàng</h5>
                            <h3 class="m-0">@Model.Count()</h3>
                        </div>
                        <div class="text-white">
                            <i class="fas fa-shopping-basket fa-3x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-action="Index">Xem tất cả</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="m-0">Đơn chờ xử lý</h5>
                            <h3 class="m-0">@Model.Count(o => o.Status == "Pending")</h3>
                        </div>
                        <div class="text-white">
                            <i class="fas fa-hourglass-start fa-3x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-action="Index" asp-route-status="Pending">Xem chi tiết</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="m-0">Doanh thu</h5>
                            <h3 class="m-0">@totalValue.ToString("N0") VNĐ</h3>
                        </div>
                        <div class="text-white">
                            <i class="fas fa-money-bill-wave fa-3x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-controller="Report" asp-action="Revenue">Báo cáo</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="m-0">Đã hủy</h5>
                            <h3 class="m-0">@Model.Count(o => o.Status == "Cancelled")</h3>
                        </div>
                        <div class="text-white">
                            <i class="fas fa-ban fa-3x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-action="Index" asp-route-status="Cancelled">Xem chi tiết</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-table me-1"></i>
                @(isAdminView ? "Danh sách đơn hàng" : "Đơn hàng của bạn")
            </div>
            <div>
                @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Tạo đơn hàng mới
                    </a>
                }
            </div>
        </div>
        <div class="card-body">
            <!-- Filter Form -->
            <div class="row mb-3">
                <div class="col-md-8">
                    <form asp-action="@(isAdminView ? "Index" : "MyOrders")" method="get" id="filterForm" class="form-inline">
                        <div class="row g-3 align-items-center">
                            <div class="col-auto">
                                <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                                    @foreach (var statusItem in statusList)
                                    {
                                        <option value="@statusItem" selected="@(statusItem == status)">@statusItem</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <div class="input-group">
                                    <input type="text" name="searchString" class="form-control" placeholder="Tìm kiếm..." value="@searchString">
                                    <button class="btn btn-outline-secondary" type="submit">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-auto">
                                <a asp-action="@(isAdminView ? "Index" : "MyOrders")" class="btn btn-outline-secondary">
                                    <i class="fas fa-sync"></i> Làm mới
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="col-md-4 text-end">
                    <div class="badge bg-success fs-6">
                        Tổng giá trị: @totalValue.ToString("N0") VNĐ
                    </div>
                </div>
            </div>
            
            <!-- Orders Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Bàn</th>
                            @if (isAdminView)
                            {
                                <th>Khách hàng</th>
                                <th>Nhân viên</th>
                            }
                            <th>Thời gian</th>
                            <th>Trạng thái</th>
                            <th>Số người</th>
                            <th>Giá trị</th>
                            <th style="min-width: 200px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var order in Model)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@(order.Table?.Name ?? "-")</td>
                                    @if (isAdminView)
                                    {
                                        <td>@(order.Customer?.Name ?? "-")</td>
                                        <td>@(order.Employee?.FullName ?? "-")</td>
                                    }
                                    <td>@order.OrderTime.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning">Chờ xử lý</span>
                                                break;
                                            case "Processing":
                                                <span class="badge bg-primary">Đang xử lý</span>
                                                break;
                                            case "Completed":
                                                <span class="badge bg-success">Hoàn thành</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>@(order.PeopleCount ?? 0)</td>
                                    <td>@order.TotalAmount.ToString("N0") VNĐ</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-info btn-sm">
                                                <i class="fas fa-eye"></i> Chi tiết
                                            </a>
                                            
                                            @if (order.Status != "Completed" && order.Status != "Cancelled")
                                            {
                                                <a asp-action="AddItem" asp-route-id="@order.Id" class="btn btn-warning btn-sm">
                                                    <i class="fas fa-plus-circle"></i> Thêm món
                                                </a>
                                                
                                                @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                                {
                                                    <!-- Botones de cambio rápido de estado -->
                                                    <div class="dropdown d-inline">
                                                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                            <i class="fas fa-tasks"></i> Trạng thái
                                                        </button>
                                                        <ul class="dropdown-menu">
                                                            @if (order.Status != "Pending")
                                                            {
                                                                <li><a class="dropdown-item" href="@Url.Action("UpdateStatus", new { id = order.Id, status = "Pending" })">Chờ xử lý</a></li>
                                                            }
                                                            @if (order.Status != "Processing")
                                                            {
                                                                <li><a class="dropdown-item" href="@Url.Action("UpdateStatus", new { id = order.Id, status = "Processing" })">Đang xử lý</a></li>
                                                            }
                                                            <li><a class="dropdown-item" href="@Url.Action("UpdateStatus", new { id = order.Id, status = "Completed" })">Hoàn thành</a></li>
                                                            <li><a class="dropdown-item text-danger" href="@Url.Action("UpdateStatus", new { id = order.Id, status = "Cancelled" })">Hủy đơn</a></li>
                                                        </ul>
                                                    </div>
                                                    
                                                    <a asp-action="Payment" asp-route-id="@order.Id" class="btn btn-success btn-sm">
                                                        <i class="fas fa-cash-register"></i> Thanh toán
                                                    </a>
                                                }
                                            }
                                            else if (order.Status == "Completed" && order.Invoice != null)
                                            {
                                                <a asp-controller="Invoice" asp-action="Details" asp-route-id="@order.Invoice.Id" class="btn btn-secondary btn-sm">
                                                    <i class="fas fa-file-invoice"></i> Hóa đơn
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(isAdminView ? 9 : 7)" class="text-center">Không có đơn hàng nào</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="@(isAdminView ? "Index" : "MyOrders")" asp-route-page="1" asp-route-status="@status" asp-route-searchString="@searchString">
                                        <i class="fas fa-angle-double-left"></i>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-action="@(isAdminView ? "Index" : "MyOrders")" asp-route-page="@(currentPage-1)" asp-route-status="@status" asp-route-searchString="@searchString">
                                        <i class="fas fa-angle-left"></i>
                                    </a>
                                </li>
                            }
                            
                            @{
                                int startPage = Math.Max(1, currentPage - 2);
                                int endPage = Math.Min(startPage + 4, totalPages);
                                
                                if (endPage - startPage < 4)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }
                            
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="@(isAdminView ? "Index" : "MyOrders")" asp-route-page="@i" asp-route-status="@status" asp-route-searchString="@searchString">
                                        @i
                                    </a>
                                </li>
                            }
                            
                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="@(isAdminView ? "Index" : "MyOrders")" asp-route-page="@(currentPage+1)" asp-route-status="@status" asp-route-searchString="@searchString">
                                        <i class="fas fa-angle-right"></i>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-action="@(isAdminView ? "Index" : "MyOrders")" asp-route-page="@totalPages" asp-route-status="@status" asp-route-searchString="@searchString">
                                        <i class="fas fa-angle-double-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Highlight success message
        $(document).ready(function () {
            setTimeout(function () {
                $(".alert").fadeOut('slow');
            }, 5000); // Hide after 5 seconds
            
            // Confirm cancel action
            $(".cancel-order").click(function(e) {
                if (!confirm("Bạn có chắc chắn muốn hủy đơn hàng này?")) {
                    e.preventDefault();
                }
            });
        });
    </script>
} 