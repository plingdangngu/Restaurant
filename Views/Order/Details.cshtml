@model RestaurantManagement.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var totalAmount = ViewData["TotalAmount"] as decimal? ?? 0;
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("Employee");
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi tiết đơn hàng #@Model.Id</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item">
            @if (isAdmin)
            {
                <a asp-action="Index">Quản lý đơn hàng</a>
            }
            else
            {
                <a asp-action="MyOrders">Đơn hàng của tôi</a>
            }
        </li>
        <li class="breadcrumb-item active">Chi tiết đơn hàng</li>
    </ol>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" id="successMessage">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" id="errorMessage">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="row">
        <!-- Order Info Column -->
        <div class="col-md-5 mb-4">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-info-circle me-1"></i>
                        Thông tin đơn hàng
                    </div>
                    @if (isAdmin)
                    {
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-edit"></i> Chỉnh sửa
                            </a>
                        </div>
                    }
                </div>
                <div class="card-body">
                    <div class="mb-3 row">
                        <label class="col-md-4 fw-bold">Mã đơn hàng:</label>
                        <div class="col-md-8">@Model.Id</div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-md-4 fw-bold">Trạng thái:</label>
                        <div class="col-md-8">
                            @switch (Model.Status)
                            {
                                case "Pending":
                                    <span class="badge bg-warning">Chờ xử lý</span>
                                    break;
                                case "Processing":
                                    <span class="badge bg-primary">Đang xử lý</span>
                                    break;
                                case "Completed":
                                    <span class="badge bg-success">Hoàn thành</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger">Đã hủy</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@Model.Status</span>
                                    break;
                            }
                            @if (isAdmin && Model.Status != "Completed" && Model.Status != "Cancelled")
                            {
                                <div class="dropdown d-inline ms-2">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="statusDropdown" data-bs-toggle="dropdown">
                                        Cập nhật
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="statusDropdown">
                                        <li><a class="dropdown-item" href="@Url.Action("UpdateStatus", new { id = Model.Id, status = "Pending" })">Chờ xử lý</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("UpdateStatus", new { id = Model.Id, status = "Processing" })">Đang xử lý</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("UpdateStatus", new { id = Model.Id, status = "Completed" })">Hoàn thành</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("UpdateStatus", new { id = Model.Id, status = "Cancelled" })">Hủy</a></li>
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-md-4 fw-bold">Thời gian đặt:</label>
                        <div class="col-md-8">@(Model.OrderTime != default ? Model.OrderTime.ToString("dd/MM/yyyy HH:mm:ss") : "-")</div>
                    </div>
                    @if (Model.CompletionTime.HasValue)
                    {
                        <div class="mb-3 row">
                            <label class="col-md-4 fw-bold">Thời gian hoàn thành:</label>
                            <div class="col-md-8">@Model.CompletionTime.Value.ToString("dd/MM/yyyy HH:mm:ss")</div>
                        </div>
                    }
                    <div class="mb-3 row">
                        <label class="col-md-4 fw-bold">Bàn:</label>
                        <div class="col-md-8">
                            @if (Model.Table != null)
                            {
                                <span>@Model.Table.Name @(Model.Table.Floor != null ? $"(Tầng {Model.Table.Floor.Name})" : "")</span>
                            }
                            else
                            {
                                <span>Không có</span>
                            }
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-md-4 fw-bold">Khách hàng:</label>
                        <div class="col-md-8">
                            @if (Model.Customer != null)
                            {
                                <span>@Model.Customer.Name</span>
                                @if (!string.IsNullOrEmpty(Model.Customer.PhoneNumber))
                                {
                                    <span class="d-block">@Model.Customer.PhoneNumber</span>
                                }
                            }
                            else
                            {
                                <span>Khách vãng lai</span>
                            }
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-md-4 fw-bold">Nhân viên:</label>
                        <div class="col-md-8">@(Model.Employee?.FullName ?? "-")</div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-md-4 fw-bold">Số người:</label>
                        <div class="col-md-8">@(Model.PeopleCount ?? 0)</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mb-3 row">
                            <label class="col-md-4 fw-bold">Ghi chú:</label>
                            <div class="col-md-8">@Model.Notes</div>
                        </div>
                    }
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary" onclick="history.back()">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </button>
                    <div>
                        @if (isAdmin && Model.Status != "Completed" && Model.Status != "Cancelled")
                        {
                            <a asp-action="AddItem" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-plus-circle"></i> Thêm món
                            </a>
                            <a asp-action="Payment" asp-route-id="@Model.Id" class="btn btn-success">
                                <i class="fas fa-cash-register"></i> Thanh toán
                            </a>
                        }
                        else if (Model.Status == "Completed")
                        {
                            <a asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.Invoice?.Id" class="btn btn-info">
                                <i class="fas fa-file-invoice"></i> Xem hóa đơn
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Order Items Column -->
        <div class="col-md-7">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-utensils me-1"></i>
                        Danh sách món ăn
                    </div>
                    <div>
                        <span class="badge bg-success fs-5">Tổng tiền: @totalAmount.ToString("N0") VNĐ</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%">Tên món</th>
                                    <th>Đơn giá</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                    @if (isAdmin)
                                    {
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderItems != null && Model.OrderItems.Any())
                                {
                                    foreach (var item in Model.OrderItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (item.MenuItem != null && !string.IsNullOrEmpty(item.MenuItem.ImageUrl))
                                                    {
                                                        <img src="@item.MenuItem.ImageUrl" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                                    }
                                                    <div>
                                                        <div>@(item.MenuItem?.Name ?? "Không xác định")</div>
                                                        @if (!string.IsNullOrEmpty(item.SpecialRequests))
                                                        {
                                                            <small class="text-muted">@item.SpecialRequests</small>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@item.Price.ToString("N0") VNĐ</td>
                                            <td>@item.Quantity</td>
                                            <td>@((item.Price * item.Quantity).ToString("N0")) VNĐ</td>
                                            @if (isAdmin)
                                            {
                                                <td>
                                                    @switch (item.Status)
                                                    {
                                                        case "Pending":
                                                            <span class="badge bg-warning">Chờ xử lý</span>
                                                            break;
                                                        case "Processing":
                                                            <span class="badge bg-primary">Đang chế biến</span>
                                                            break;
                                                        case "Ready":
                                                            <span class="badge bg-info">Sẵn sàng</span>
                                                            break;
                                                        case "Served":
                                                            <span class="badge bg-success">Đã phục vụ</span>
                                                            break;
                                                        case "Cancelled":
                                                            <span class="badge bg-danger">Đã hủy</span>
                                                            break;
                                                        default:
                                                            <span class="badge bg-secondary">@(item.Status ?? "Không xác định")</span>
                                                            break;
                                                    }
                                                    
                                                    @if (Model.Status != "Completed" && Model.Status != "Cancelled")
                                                    {
                                                        <div class="dropdown d-inline ms-1">
                                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle py-0" type="button" data-bs-toggle="dropdown">
                                                                <i class="fas fa-cog fa-xs"></i>
                                                            </button>
                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                <li><a class="dropdown-item" href="@Url.Action("UpdateItemStatus", new { id = item.Id, status = "Pending" })">Chờ xử lý</a></li>
                                                                <li><a class="dropdown-item" href="@Url.Action("UpdateItemStatus", new { id = item.Id, status = "Processing" })">Đang chế biến</a></li>
                                                                <li><a class="dropdown-item" href="@Url.Action("UpdateItemStatus", new { id = item.Id, status = "Ready" })">Sẵn sàng</a></li>
                                                                <li><a class="dropdown-item" href="@Url.Action("UpdateItemStatus", new { id = item.Id, status = "Served" })">Đã phục vụ</a></li>
                                                                <li><a class="dropdown-item" href="@Url.Action("UpdateItemStatus", new { id = item.Id, status = "Cancelled" })">Hủy</a></li>
                                                            </ul>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    @if (Model.Status != "Completed" && Model.Status != "Cancelled")
                                                    {
                                                        <form asp-action="RemoveItem" asp-route-id="@item.Id" method="post" class="d-inline"
                                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa món này?')">
                                                            <input type="hidden" name="orderId" value="@Model.Id" />
                                                            <button type="submit" class="btn btn-danger btn-sm">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@(isAdmin ? 6 : 4)" class="text-center">Chưa có món ăn nào</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (isAdmin && Model.Status != "Completed" && Model.Status != "Cancelled")
                {
                    <div class="card-footer">
                        <div class="d-flex justify-content-end">
                            <a asp-action="AddItem" asp-route-id="@Model.Id" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Thêm món ăn
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $(".alert").fadeOut('slow');
            }, 5000); // Hide after 5 seconds
        });
    </script>
} 