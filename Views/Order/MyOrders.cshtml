@model List<RestaurantManagement.Models.Order>
@{
    var currentPage = (int)ViewData["CurrentPage"];
    var totalPages = (int)ViewData["TotalPages"];
    var status = (string)ViewData["Status"];
    var searchString = (string)ViewData["SearchString"];
    var statusList = (List<string>)ViewData["StatusList"];
    var totalValue = (decimal)ViewData["TotalValue"];
    var totalItems = Model?.Count ?? 0;
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("Employee");
    
    ViewData["Title"] = "Đơn hàng của tôi";
}

@section Styles {
    <style>
        .order-summary-card {
            background: linear-gradient(to right, #11998e, #38ef7d);
            color: white;
            border-radius: 10px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        
        .price-badge {
            font-size: 1.5rem;
            font-weight: bold;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.2);
            padding: 10px 15px;
        }
        
        .order-table th {
            background-color: #0277bd;
            color: white;
        }
        
        .table-row-hover:hover {
            background-color: rgba(23, 162, 184, 0.1) !important;
            transform: translateY(-2px);
            transition: all 0.2s;
        }
        
        .order-value {
            font-weight: bold;
            font-size: 1.1rem;
            color: #28a745;
        }
        
        .btn-action {
            margin-right: 5px;
            transition: all 0.3s;
        }
        
        .btn-action:hover {
            transform: scale(1.1);
        }
        
        .status-badge {
            padding: 8px 12px;
            font-weight: 500;
        }
        
        .filter-section {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            border: 1px solid #dee2e6;
        }
        
        .order-count {
            margin-top: 10px;
            font-weight: 500;
            color: #555;
        }
    </style>
}

<div class="container-fluid px-4">
    <h1 class="mt-4">@ViewData["Title"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item active">@ViewData["Title"]</li>
    </ol>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <!-- Thống kê tổng quan -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="order-summary-card p-4">
                <h4><i class="fas fa-shopping-bag me-2"></i> Tổng quan đơn hàng</h4>
                <div class="row mt-3">
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-file-invoice-dollar fa-2x me-3"></i>
                            <div>
                                <div class="text-white-50">Số lượng đơn hàng</div>
                                <div class="fs-4">@(Model != null ? Model.Count : 0)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-money-bill-wave fa-2x me-3"></i>
                            <div>
                                <div class="text-white-50">Tổng giá trị</div>
                                <div class="fs-4">@totalValue.ToString("N0") VNĐ</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body p-4">
                    <h5 class="card-title"><i class="fas fa-filter me-2"></i> Lọc đơn hàng</h5>
                    <form asp-action="MyOrders" method="get" id="filterForm" class="mt-3">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-4">
                                <label class="form-label">Trạng thái</label>
                                <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                                    @foreach (var statusItem in statusList)
                                    {
                                        <option value="@statusItem" selected="@(statusItem == status)">@statusItem</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Tìm kiếm</label>
                                <div class="input-group">
                                    <input type="text" name="searchString" class="form-control" placeholder="Nhập từ khóa..." value="@searchString">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <a asp-action="MyOrders" class="btn btn-outline-secondary w-100">
                                    <i class="fas fa-sync-alt"></i> Làm mới
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-list me-1"></i>
                    Danh sách đơn hàng của bạn
                </div>
                <div>
                    <span class="badge bg-light text-primary price-badge">
                        <i class="fas fa-coins me-1"></i> Tổng giá trị: @totalValue.ToString("N0") VNĐ
                    </span>
                </div>
            </div>
        </div>
        <div class="card-body">
            <!-- Orders Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered order-table">
                    <thead>
                        <tr>
                            <th style="width: 8%">Mã đơn</th>
                            <th style="width: 12%">Bàn</th>
                            <th style="width: 18%">Thời gian</th>
                            <th style="width: 15%">Trạng thái</th>
                            <th style="width: 10%">Số người</th>
                            <th style="width: 20%" class="text-end">Giá trị</th>
                            <th style="width: 17%">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var order in Model)
                            {
                                <tr class="table-row-hover">
                                    <td class="fw-bold">#@order.Id</td>
                                    <td>
                                        @if (order.Table != null)
                                        {
                                            <span class="badge bg-info text-white">
                                                <i class="fas fa-chair me-1"></i>
                                                @(order.Table.Name)
                                            </span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="far fa-clock me-1"></i>
                                        @order.OrderTime.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark status-badge">
                                                    <i class="fas fa-hourglass-start me-1"></i> Chờ xử lý
                                                </span>
                                                break;
                                            case "Processing":
                                                <span class="badge bg-primary status-badge">
                                                    <i class="fas fa-cog fa-spin me-1"></i> Đang xử lý
                                                </span>
                                                break;
                                            case "Completed":
                                                <span class="badge bg-success status-badge">
                                                    <i class="fas fa-check-circle me-1"></i> Hoàn thành
                                                </span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-danger status-badge">
                                                    <i class="fas fa-times-circle me-1"></i> Đã hủy
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary status-badge">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-users me-1"></i> @(order.PeopleCount ?? 0)
                                        </span>
                                    </td>
                                    <td class="text-end order-value">
                                        <span class="badge bg-success fs-6 p-2">
                                            <i class="fas fa-money-bill-wave me-1"></i>
                                            @order.TotalAmount.ToString("N0") VNĐ
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-info btn-sm btn-action me-1" data-bs-toggle="tooltip" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (isAdmin && order.Status != "Completed" && order.Status != "Cancelled")
                                            {
                                                <a asp-action="AddItem" asp-route-id="@order.Id" class="btn btn-warning btn-sm btn-action" data-bs-toggle="tooltip" title="Thêm món">
                                                    <i class="fas fa-plus-circle"></i>
                                                </a>
                                            }
                                            @if (order.Status == "Completed")
                                            {
                                                <a asp-controller="Invoice" asp-action="Details" asp-route-id="@order.Invoice?.Id" class="btn btn-success btn-sm btn-action ms-1" data-bs-toggle="tooltip" title="Xem hóa đơn">
                                                    <i class="fas fa-file-invoice"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="alert alert-info mb-0">
                                        <i class="fas fa-info-circle me-2"></i>
                                        Bạn chưa có đơn hàng nào
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="MyOrders" asp-route-page="1" asp-route-status="@status" asp-route-searchString="@searchString">
                                        <i class="fas fa-angle-double-left"></i>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-action="MyOrders" asp-route-page="@(currentPage-1)" asp-route-status="@status" asp-route-searchString="@searchString">
                                        <i class="fas fa-angle-left"></i>
                                    </a>
                                </li>
                            }
                            
                            @{
                                int startPage = Math.Max(1, currentPage - 2);
                                int endPage = Math.Min(startPage + 4, totalPages);
                                
                                if (endPage - startPage < 4)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }
                            
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="MyOrders" asp-route-page="@i" asp-route-status="@status" asp-route-searchString="@searchString">
                                        @i
                                    </a>
                                </li>
                            }
                            
                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="MyOrders" asp-route-page="@(currentPage+1)" asp-route-status="@status" asp-route-searchString="@searchString">
                                        <i class="fas fa-angle-right"></i>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-action="MyOrders" asp-route-page="@totalPages" asp-route-status="@status" asp-route-searchString="@searchString">
                                        <i class="fas fa-angle-double-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
            
            @if (Model != null && Model.Any())
            {
                <div class="order-count text-center mt-3">
                    <i class="fas fa-info-circle me-1"></i>
                    Hiển thị @Model.Count đơn hàng trên tổng số @totalItems đơn hàng
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Hiệu ứng mờ dần thông báo
            setTimeout(function () {
                $("#successMessage").fadeOut('slow');
            }, 5000); // Hide after 5 seconds
            
            // Kích hoạt tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
} 