@model RestaurantManagement.Models.Customer

@{
    ViewData["Title"] = "Chi tiết khách hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">@ViewData["Title"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách khách hàng</a></li>
        <li class="breadcrumb-item active">@ViewData["Title"]</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-user me-1"></i>
            Thông tin khách hàng
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="fw-bold">Tên khách hàng:</label>
                        <p>@Html.DisplayFor(model => model.Name)</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="fw-bold">Số điện thoại:</label>
                        <p>@Html.DisplayFor(model => model.Phone)</p>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="fw-bold">Email:</label>
                        <p>@Html.DisplayFor(model => model.Email)</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="fw-bold">Điểm tích lũy:</label>
                        <p>@Html.DisplayFor(model => model.Points)</p>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="fw-bold">Địa chỉ:</label>
                <p>@Html.DisplayFor(model => model.Address)</p>
            </div>

            <div class="form-group mb-3">
                <label class="fw-bold">Ghi chú:</label>
                <p>@(string.IsNullOrEmpty(Model.Notes) ? "Không có" : Model.Notes)</p>
            </div>

            <div class="form-group mb-3">
                <label class="fw-bold">Ngày tạo:</label>
                <p>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Sửa
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-list"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div> 