@model RestaurantManagement.Models.Dashboard.DashboardData

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h1 class="mt-4">Dashboard</h1>
    <p class="lead">Tổng quan hệ thống quản lý nhà hàng</p>

    <!-- Statistics Cards -->
    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h4>@string.Format("{0:N0}", Model.TodayRevenue) VNĐ</h4>
                    <div>Doanh thu hôm nay</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <div class="small text-white">Tuần này: @string.Format("{0:N0}", Model.WeekRevenue) VNĐ</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <h4>@Model.TodayOrderCount</h4>
                    <div>Đơn hàng hôm nay</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <div class="small text-white">Đã hoàn thành: @Model.CompletedOrderCount</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <h4>@Model.AvailableTableCount / @Model.TotalTableCount</h4>
                    <div>Bàn còn trống</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <div class="small text-white">Đang sử dụng: @Model.OccupiedTableCount bàn</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white mb-4">
                <div class="card-body">
                    <h4>@Model.PendingOrderCount</h4>
                    <div>Đơn hàng đang chờ</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <div class="small text-white">Đang xử lý: @Model.ProcessingOrderCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Revenue Chart and Top Menu Items -->
    <div class="row">
        <div class="col-xl-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-1"></i>
                    Doanh thu 7 ngày gần đây
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" width="100%" height="40"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-utensils me-1"></i>
                    Món ăn bán chạy
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @foreach (var item in Model.TopMenuItems)
                        {
                            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@item.Name</strong>
                                    <div class="small">@string.Format("{0:N0}", item.TotalRevenue) VNĐ</div>
                                </div>
                                <span class="badge bg-primary rounded-pill">@item.OrderCount</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Đơn hàng gần đây
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="recentOrdersTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Thời gian</th>
                            <th>Bàn</th>
                            <th>Khách hàng</th>
                            <th>Nhân viên</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.OrderTime.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(order.Table?.Name ?? "N/A")</td>
                                <td>@(order.Customer?.FullName ?? "Khách vãng lai")</td>
                                <td>@(order.Employee?.FullName ?? "N/A")</td>
                                <td>
                                    @switch (order.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning">Đang chờ</span>
                                            break;
                                        case "Processing":
                                            <span class="badge bg-info">Đang xử lý</span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-success">Hoàn thành</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@order.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart data
        var labels = @Html.Raw(Json.Serialize(Model.RevenueChartData.Select(d => d.Date).ToArray()));
        var data = @Html.Raw(Json.Serialize(Model.RevenueChartData.Select(d => d.Revenue).ToArray()));
        
        // Create chart
        var ctx = document.getElementById('revenueChart');
        var myChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: data,
                    backgroundColor: 'rgba(54, 162, 235, 0.5)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return new Intl.NumberFormat('vi-VN').format(value) + ' đ';
                            }
                        }
                    }
                }
            }
        });
        
        // Initialize DataTable
        $(document).ready(function () {
            $('#recentOrdersTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json'
                },
                order: [[1, 'desc']]
            });
        });
    </script>
} 