@model RestaurantManagement.Models.ApplicationUser

@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Trở lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info">
                        <i class="bi bi-pencil"></i> Chỉnh sửa
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Thông tin tài khoản</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-4">Email:</dt>
                                    <dd class="col-sm-8">@Model.Email</dd>
                                    
                                    <dt class="col-sm-4">Username:</dt>
                                    <dd class="col-sm-8">@Model.UserName</dd>
                                    
                                    <dt class="col-sm-4">Vai trò:</dt>
                                    <dd class="col-sm-8">@ViewData["Roles"]</dd>
                                    
                                    <dt class="col-sm-4">Trạng thái:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Đã khóa</span>
                                        }
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Thông tin cá nhân</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-4">Họ tên:</dt>
                                    <dd class="col-sm-8">@Model.FullName</dd>
                                    
                                    <dt class="col-sm-4">Địa chỉ:</dt>
                                    <dd class="col-sm-8">@Model.Address</dd>
                                    
                                    <dt class="col-sm-4">Điện thoại:</dt>
                                    <dd class="col-sm-8">@Model.PhoneNumber</dd>
                                    
                                    <dt class="col-sm-4">Ngày tạo:</dt>
                                    <dd class="col-sm-8">@Model.JoinDate.ToString("dd/MM/yyyy")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-3">
                    <form asp-controller="Account" asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post"
                          class="d-inline-block"
                          onsubmit="return confirm('@(Model.IsActive ? "Bạn có chắc muốn khóa tài khoản này?" : "Bạn có chắc muốn kích hoạt tài khoản này?")');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn @(Model.IsActive ? "btn-danger" : "btn-success")">
                            <i class="bi @(Model.IsActive ? "bi-lock" : "bi-unlock")"></i>
                            @(Model.IsActive ? "Khóa tài khoản" : "Kích hoạt tài khoản")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 